# ─────────────────────────────────────────────────────────────────────────────
# NOUFON — Environment Variables Reference
# ─────────────────────────────────────────────────────────────────────────────
# This file documents every environment variable the project needs.
# Set these in the Netlify dashboard:
#   Site → Site configuration → Environment variables
#
# DO NOT commit a real .env file with actual secrets to this repository.
# ─────────────────────────────────────────────────────────────────────────────


# ── Netlify Function: send-contact-email ──────────────────────────────────────
# SMTP credentials used by nodemailer to send contact form notifications.
# Recommended: use a dedicated transactional email address (e.g. Gmail App Password
# or an SMTP relay from Brevo/SendGrid).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
CONTACT_EMAIL_TO=info@noufon.com


# ── Brevo (formerly Sendinblue) ───────────────────────────────────────────────
# API key for Brevo integrations (forms, contacts, automations).
# Get it from: https://app.brevo.com → Account → SMTP & API → API Keys

BREVO_API_KEY=your-brevo-api-key-here
BREVO_LIST_ID=3


# ── Google Analytics 4 ───────────────────────────────────────────────────────
# Measurement ID for the GA4 property.
# Get it from: Google Analytics → Admin → Data Streams → Web stream details

GA4_MEASUREMENT_ID=G-XXXXXXXXXX


# ── Google Tag Manager ────────────────────────────────────────────────────────
# Container ID for the GTM workspace.
# Get it from: https://tagmanager.google.com → your container

GTM_CONTAINER_ID=GTM-XXXXXXX


# ── Calendly ─────────────────────────────────────────────────────────────────
# Your Calendly scheduling link, embedded in call-to-action sections.
# Get it from: https://calendly.com → Event Types → copy link

CALENDLY_URL=https://calendly.com/noufon/demo


# ── Site ──────────────────────────────────────────────────────────────────────
# Public site URL (used in canonical tags, OG metadata, sitemap).

SITE_URL=https://noufon.com
