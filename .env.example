# NOUFON — Environment Variables Reference
# Set these in: Netlify → Site configuration → Environment variables
# DO NOT commit a real .env file with actual secrets.

# ── send-contact-email (nodemailer SMTP) ─────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
CONTACT_EMAIL_TO=info@noufon.com

# ── Brevo ─────────────────────────────────────────────────────────────────────
BREVO_API_KEY=your-brevo-api-key-here
BREVO_LIST_ID=3

# ── Google Analytics 4 ───────────────────────────────────────────────────────
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Google Tag Manager ────────────────────────────────────────────────────────
GTM_CONTAINER_ID=GTM-XXXXXXX

# ── Calendly ─────────────────────────────────────────────────────────────────
CALENDLY_URL=https://calendly.com/noufon/demo

# ── Site ─────────────────────────────────────────────────────────────────────
SITE_URL=https://noufon.com
